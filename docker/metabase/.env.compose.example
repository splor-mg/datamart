# Para compose.metabase.yaml. Copie para .env.compose nesta pasta.
# Gere senhas/chave diferentes e preserve-as entre deploys, fora do Git.
METABASE_POSTGRES_ADMIN_PASSWORD=
METABASE_DB_PASSWORD=
METABASE_ENCRYPTION_SECRET_KEY=
METABASE_SITE_URL=https://datamart-metabase.h0ydxp.easypanel.host
# Rede compartilhada que permite acesso do proxy e ao datamart-postgres.
# Rede attachable confirmada nesta VM em 23/11/2026.
EASYPANEL_NETWORK=easypanel
# Alias correspondente ao projeto/item Compose usado pelo proxy Easypanel.
METABASE_PROXY_ALIAS=datamart_metabase-compose_metabase
