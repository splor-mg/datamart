# Substitua projeto_postgres pelo DNS interno exibido no Easypanel.
MB_DB_HOST=projeto_postgres
# Mesmo valor de METABASE_DB_PASSWORD no serviço PostgreSQL.
MB_DB_PASS=
# Chave própria e persistente para proteger as credenciais das fontes.
MB_ENCRYPTION_SECRET_KEY=
MB_SITE_URL=https://bi-lab.exemplo.gov.br
# MB_DB_PORT=5432
# MB_DB_DBNAME=metabase
# MB_DB_USER=metabase
# Opcional: URI JDBC explícita, sem senha; o padrão exige sslmode=require.
# MB_DB_CONNECTION_URI=jdbc:postgresql://projeto_postgres:5432/metabase?sslmode=require
