# Para o template nativo do Easypanel / imagem oficial, sem o Dockerfile deste repo.
# Crie antes a role e o banco metabase no PostgreSQL existente.
MB_DB_TYPE=postgres
# Substitua pelo hostname INTERNO mostrado nas credenciais do PostgreSQL.
MB_DB_HOST=datamart_datamart-postgres
MB_DB_PORT=5432
MB_DB_DBNAME=metabase
MB_DB_USER=metabase
# Senha da role metabase, definida com o comando psql \password metabase.
MB_DB_PASS=
MB_SITE_URL=https://bi-lab.exemplo.gov.br
# Opcional. Se já configurada, preserve a mesma chave durante a migração.
# MB_ENCRYPTION_SECRET_KEY=
# Remova MB_DB_FILE e qualquer MB_DB_CONNECTION_URI antiga do ambiente.
# A conexão acima usa a rede interna; não exige o TLS do Dockerfile personalizado.
