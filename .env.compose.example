# Copie para .env.compose. Use uma senha/chave diferente para cada variável.
# Gere cada valor com: python -c "import secrets; print(secrets.token_hex(32))"
# As chaves Giftless devem ser strings hexadecimais de 64 caracteres.
POSTGRES_PASSWORD=
DATAMART_PASSWORD=
METABASE_DB_PASSWORD=
METABASE_READER_PASSWORD=
METABASE_ENCRYPTION_SECRET=
GIFTLESS_JWT_SECRET=
GIFTLESS_INTERNAL_SECRET=

# Ambiente do Compose local. No Easypanel, use os três Dockerfiles e
# os exemplos de ambiente próprios de cada serviço em docker/.
POSTGRES_BIND_HOST=127.0.0.1
POSTGRES_PORT=5432

# Metabase/Giftless devem ser publicados pelo proxy HTTPS do Easypanel.
HTTP_BIND_HOST=127.0.0.1
METABASE_PORT=3000
GIFTLESS_PORT=8080
METABASE_SITE_URL=http://localhost:3000
